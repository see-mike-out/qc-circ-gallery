		"svelte-check": "^4.3.6",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@duckdb/node-api": "^1.4.4-r.1",
		"csv-parser": "^3.2.0"
